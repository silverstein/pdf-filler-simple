{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-tools.local/schemas/olmocr-bench-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "suite_version",
    "benchmark_claim_ready",
    "source",
    "execution",
    "scorer",
    "claim_boundary",
    "reference_run"
  ],
  "properties": {
    "suite_id": { "const": "pdf-tools.olmocr-bench.directional.v1" },
    "suite_version": { "const": 1 },
    "benchmark_claim_ready": { "const": false },
    "source": {
      "type": "object",
      "required": ["repository", "revision", "license", "redistribution", "corpus_directory", "metadata", "pdf_inventory", "categories"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license": { "const": "ODC-BY-1.0" },
        "redistribution": { "const": "external_only" },
        "corpus_directory": { "const": "bench_data" },
        "metadata": { "type": "object", "minProperties": 3 },
        "pdf_inventory": {
          "type": "object",
          "required": ["count", "total_size_bytes", "canonical_inventory_sha256"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "total_size_bytes": { "type": "integer", "minimum": 1 },
            "canonical_inventory_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file", "sha256", "size_bytes", "test_count", "unique_pdf_count"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "pattern": "^bench_data/[a-z_]+\\.jsonl$" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size_bytes": { "type": "integer", "minimum": 1 },
              "test_count": { "type": "integer", "minimum": 1 },
              "unique_pdf_count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "execution": { "type": "object" },
    "scorer": { "type": "object" },
    "claim_boundary": { "type": "object" },
    "reference_run": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
