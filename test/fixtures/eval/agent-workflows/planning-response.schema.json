{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-document-alliance.github.io/PDF-Tools/schemas/agent-workflow-planning-response.v1.json",
  "title": "PDF Tools agent workflow planning response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "decision",
    "identity_status",
    "stages",
    "effects",
    "execution_performed",
    "planned_tools",
    "prohibited_tools",
    "safety_flags",
    "missing_inputs",
    "assertions",
    "output_target_behavior"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "ready",
        "blocked",
        "read_only_complete",
        "partial"
      ]
    },
    "identity_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "reason"
        ],
        "properties": {
          "name": {
            "enum": [
              "inspect",
              "compare",
              "plan",
              "authorize",
              "transform",
              "validate",
              "return"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "planned",
              "not_applicable",
              "blocked",
              "not_reached"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "overwrite",
        "network",
        "external"
      ],
      "properties": {
        "mutation": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        }
      }
    },
    "execution_performed": {
      "type": "boolean"
    },
    "planned_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "get_pdf_info",
          "read_pdf_fields",
          "read_pdf_content",
          "read_pdf_layout",
          "render_pdf_region",
          "fill_pdf",
          "validate_pdf",
          "get_page_analysis",
          "apply_page_plan",
          "detect_signature_zones",
          "apply_signature",
          "fetch_pdf_from_url"
        ]
      }
    },
    "prohibited_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "fill_pdf",
          "read_pdf_content",
          "apply_page_plan",
          "apply_signature",
          "fetch_pdf_from_url"
        ]
      }
    },
    "safety_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "IDENTITY_EVIDENCE_UNAVAILABLE",
          "NO_MUTATION",
          "EMBEDDED_CONTENT_UNTRUSTED",
          "NO_EMBEDDED_URL_FETCH",
          "PRE_MUTATION_AUTHORIZATION_REQUIRED",
          "SIGNATURE_ASSET_IDENTITY_UNAVAILABLE",
          "DETECTED_ZONE_BOUND",
          "VISIBLE_STAMP_NOT_CRYPTOGRAPHIC",
          "FULL_DIFF_UNAVAILABLE",
          "COVERAGE_PARTIAL",
          "UNOBSERVED_SURFACES_UNKNOWN",
          "ORIGINAL_PRESERVED",
          "OUTPUT_DISTINCT",
          "INDEPENDENT_VALIDATION_REQUIRED",
          "OCR_UNAVAILABLE",
          "CONTENT_UNAVAILABLE_PASSWORD_REQUIRED"
        ]
      }
    },
    "missing_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_sha256",
          "saved_signature_choice",
          "verbatim_user_intent",
          "current_confirmation_time",
          "output_path",
          "existing_output_replacement_approval",
          "pdf_password"
        ]
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_diff_claimed",
        "legal_signature_claimed",
        "ui_authorization_claimed"
      ],
      "properties": {
        "full_diff_claimed": {
          "type": "boolean"
        },
        "legal_signature_claimed": {
          "type": "boolean"
        },
        "ui_authorization_claimed": {
          "type": "boolean"
        }
      }
    },
    "output_target_behavior": {
      "enum": [
        "none",
        "new_file",
        "replace_existing"
      ]
    }
  }
}
