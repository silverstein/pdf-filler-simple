          "required": ["truth_data_leaves", "candidate_data_leaves", "correct", "wrong", "missing", "spurious", "shifted_array", "false_answers", "false_abstentions", "correctly_abstained", "typed_gap_correct", "typed_gap_wrong_reason", "precision", "recall", "f1", "false_answer_rate", "selective_abstention_coverage", "selective_abstention_accuracy"],
