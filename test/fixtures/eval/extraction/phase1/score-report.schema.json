{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/score-report.schema.json",
  "title": "PDF Tools extraction Phase 1 score report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["score_report_id", "score_report_version", "benchmark_claim_ready", "calibration_claim_ready", "canonical_evidence_claim_ready", "scorer_id", "scorer_contract_sha256", "scorer_sources", "scorer_local_source_set_sha256", "execution_report_sha256", "execution_report_bytes_sha256", "phase0_manifest_sha256", "oracle_sha256", "oracle_bytes_sha256", "oracle_schema_sha256", "layout_oracle_sha256", "layout_oracle_bytes_sha256", "layout_oracle_schema_sha256", "preflight_evidence_sha256", "preflight_evidence_bytes_sha256", "attempts", "aggregate", "stability", "canonical_evidence", "unavailable_claims"],
  "properties": {
