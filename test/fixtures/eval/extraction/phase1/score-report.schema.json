    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_key", "candidate_id", "case_id", "repetition", "outcome", "quality_available", "semantic_sha256", "structured", "text", "table", "canonical_evidence", "resources"],
      "properties": {
        "attempt_key": { "type": "string", "minLength": 1 }, "candidate_id": { "type": "string", "minLength": 1 }, "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 }, "outcome": { "enum": ["completed", "partial", "abstained", "error", "not_run"] }, "quality_available": { "type": "boolean" },
