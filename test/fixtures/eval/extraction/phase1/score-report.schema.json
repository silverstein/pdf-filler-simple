        "cells": { "type": "object", "additionalProperties": false, "required": ["correct", "expected", "wrong", "missing", "spurious", "precision", "recall", "f1"], "properties": { "correct": { "type": "integer", "minimum": 0 }, "expected": { "type": "integer", "minimum": 0 }, "wrong": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "spurious": { "type": "integer", "minimum": 0 }, "precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } } },
        "blank": { "$ref": "#/$defs/countClass" }, "null": { "$ref": "#/$defs/countClass" }, "zero": { "$ref": "#/$defs/countClass" }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["spawned", "elapsed_ms", "stdout_bytes", "stderr_bytes", "source_bytes", "request_bytes", "source_immutable", "timed_out", "stdout_limit_exceeded", "stderr_limit_exceeded", "process_group_termination_attempted", "process_group_empty_after_cleanup", "process_tree_peak_rss_bytes", "network_egress_bytes"],
