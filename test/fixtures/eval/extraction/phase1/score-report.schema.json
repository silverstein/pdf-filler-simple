      "type": "object", "additionalProperties": false,
      "required": ["available", "schema_valid", "schema_scope", "contract_leaves", "data_leaves"],
      "properties": { "available": { "type": "boolean" }, "schema_valid": { "type": ["boolean", "null"] }, "schema_scope": { "enum": ["not_applicable", "answered_projection", "complete_target"] }, "contract_leaves": { "$ref": "#/$defs/contractLeaves" }, "data_leaves": { "$ref": "#/$defs/dataLeaves" } }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "pages", "pages_present", "duplicate_pages", "spurious_pages", "fragments", "fragments_found", "ordered_pages", "ordered_fragments_found", "character_distance", "characters", "word_distance", "words", "fragment_recall", "reading_order_accuracy", "ordered_fragment_recall", "cer", "wer"],
      "properties": {
        "available": { "type": "boolean" }, "pages": { "type": "integer", "minimum": 0 }, "pages_present": { "type": "integer", "minimum": 0 }, "duplicate_pages": { "type": "integer", "minimum": 0 }, "spurious_pages": { "type": "integer", "minimum": 0 },
        "fragments": { "type": "integer", "minimum": 0 }, "fragments_found": { "type": "integer", "minimum": 0 }, "ordered_pages": { "type": "integer", "minimum": 0 }, "ordered_fragments_found": { "type": "integer", "minimum": 0 },
