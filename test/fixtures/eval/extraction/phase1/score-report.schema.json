          "required": ["pages", "pages_present", "duplicate_pages", "spurious_pages", "fragments", "fragments_found", "ordered_pages", "ordered_fragments_found", "character_distance", "characters", "word_distance", "words", "fragment_recall", "reading_order_accuracy", "ordered_fragment_recall", "cer", "wer"],
          "properties": { "pages": { "type": "integer", "minimum": 0 }, "pages_present": { "type": "integer", "minimum": 0 }, "duplicate_pages": { "type": "integer", "minimum": 0 }, "spurious_pages": { "type": "integer", "minimum": 0 }, "fragments": { "type": "integer", "minimum": 0 }, "fragments_found": { "type": "integer", "minimum": 0 }, "ordered_pages": { "type": "integer", "minimum": 0 }, "ordered_fragments_found": { "type": "integer", "minimum": 0 }, "character_distance": { "type": "integer", "minimum": 0 }, "characters": { "type": "integer", "minimum": 0 }, "word_distance": { "type": "integer", "minimum": 0 }, "words": { "type": "integer", "minimum": 0 }, "fragment_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "reading_order_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "ordered_fragment_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "cer": { "type": ["number", "null"], "minimum": 0 }, "wer": { "type": ["number", "null"], "minimum": 0 } }
        },
        "table": {
          "type": "object", "additionalProperties": false,
          "required": ["applicable_attempts", "detected", "expected_tables", "observed_tables", "missing_tables", "spurious_tables", "cells_correct", "cells_expected", "cells_wrong", "cells_missing", "cells_spurious", "spans_correct", "spans_expected", "spans_spurious", "cell_precision", "cell_recall", "cell_f1", "topology_accuracy", "span_precision", "span_recall", "span_f1"],
          "properties": { "applicable_attempts": { "type": "integer", "minimum": 0 }, "detected": { "type": "integer", "minimum": 0 }, "expected_tables": { "type": "integer", "minimum": 0 }, "observed_tables": { "type": "integer", "minimum": 0 }, "missing_tables": { "type": "integer", "minimum": 0 }, "spurious_tables": { "type": "integer", "minimum": 0 }, "cells_correct": { "type": "integer", "minimum": 0 }, "cells_expected": { "type": "integer", "minimum": 0 }, "cells_wrong": { "type": "integer", "minimum": 0 }, "cells_missing": { "type": "integer", "minimum": 0 }, "cells_spurious": { "type": "integer", "minimum": 0 }, "spans_correct": { "type": "integer", "minimum": 0 }, "spans_expected": { "type": "integer", "minimum": 0 }, "spans_spurious": { "type": "integer", "minimum": 0 }, "cell_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "cell_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "cell_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "topology_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "span_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "span_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "span_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }
        },
