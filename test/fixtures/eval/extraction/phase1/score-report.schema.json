      "properties": {
        "total": { "type": "integer", "minimum": 1 }, "expected_answer": { "type": "integer", "minimum": 0 }, "expected_abstain": { "type": "integer", "minimum": 0 },
        "answered_expected": { "type": "integer", "minimum": 0 }, "correctly_abstained": { "type": "integer", "minimum": 0 }, "false_answers": { "type": "integer", "minimum": 0 },
        "false_abstentions": { "type": "integer", "minimum": 0 }, "typed_gap_correct": { "type": "integer", "minimum": 0 }, "typed_gap_wrong_reason": { "type": "integer", "minimum": 0 },
        "false_answer_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "selective_abstention_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "selective_abstention_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "dataLeaves": {
      "type": "object", "additionalProperties": false,
      "required": ["truth", "candidate", "correct", "wrong", "missing", "spurious", "shifted_array", "precision", "recall", "f1"],
      "properties": {
        "truth": { "type": "integer", "minimum": 0 }, "candidate": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 },
        "wrong": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "spurious": { "type": "integer", "minimum": 0 }, "shifted_array": { "type": "integer", "minimum": 0 },
        "precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
