    "canonical_evidence_claim_ready": { "const": false },
    "scorer_id": { "const": "pdf-tools.extraction-phase1-scorer.v1" },
    "scorer_contract_sha256": { "$ref": "#/$defs/sha256" },
    "scorer_sources": { "type": "array", "minItems": 39, "maxItems": 39, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceBinding" } },
