              "required": ["completed", "partial", "abstained", "error", "not_run"],
              "properties": { "completed": { "type": "integer", "minimum": 0 }, "partial": { "type": "integer", "minimum": 0 }, "abstained": { "type": "integer", "minimum": 0 }, "error": { "type": "integer", "minimum": 0 }, "not_run": { "type": "integer", "minimum": 0 } }
            }
