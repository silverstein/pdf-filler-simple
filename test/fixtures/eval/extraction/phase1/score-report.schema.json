        "applicable": { "type": "integer", "minimum": 0 }, "evaluable": { "type": "integer", "minimum": 0 }, "matched": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "spurious": { "type": "integer", "minimum": 0 },
        "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "canonicalEvidenceAttempt": {
      "type": "object", "additionalProperties": false, "required": ["availability", "reason", "page", "bbox", "fact", "answer"],
      "properties": { "availability": { "enum": ["unavailable", "partial", "measured"] }, "reason": { "type": ["string", "null"] }, "page": { "$ref": "#/$defs/canonicalMetric" }, "bbox": { "$ref": "#/$defs/canonicalMetric" }, "fact": { "$ref": "#/$defs/canonicalMetric" }, "answer": { "$ref": "#/$defs/canonicalMetric" } }
    },
    "canonicalEvidenceAggregate": {
      "type": "object", "additionalProperties": false, "required": ["availability", "page", "bbox", "fact", "answer"],
      "properties": { "availability": { "enum": ["unavailable", "partial", "measured"] }, "page": { "$ref": "#/$defs/canonicalMetric" }, "bbox": { "$ref": "#/$defs/canonicalMetric" }, "fact": { "$ref": "#/$defs/canonicalMetric" }, "answer": { "$ref": "#/$defs/canonicalMetric" } }
    },
    "countClass": {
      "type": "object", "additionalProperties": false,
      "required": ["expected", "correct", "wrong", "missing"],
      "properties": { "expected": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 }, "wrong": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 } }
    },
    "contractLeaves": {
