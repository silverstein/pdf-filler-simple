{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/layout-occurrence-oracle.schema.json",
  "title": "PDF Tools extraction Phase 1 layout occurrence oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle_id", "oracle_version", "manifest_bindings", "scoring_oracle_bindings", "layout_contract_bindings", "validator_sources", "validator_source_set_sha256", "pdfjs_version", "generation_contract", "cases"],
  "properties": {
    "oracle_id": { "const": "pdf-tools.extraction-phase1-layout-occurrence-oracle.v1" },
    "oracle_version": { "const": 1 },
    "manifest_bindings": { "$ref": "#/$defs/dualBindings" },
    "scoring_oracle_bindings": { "$ref": "#/$defs/dualBindings" },
    "layout_contract_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["layout_output_schema_sha256", "layout_evidence_contract_sha256"],
      "properties": {
        "layout_output_schema_sha256": { "$ref": "#/$defs/sha256" },
        "layout_evidence_contract_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validator_sources": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/sourceBinding" } },
    "validator_source_set_sha256": { "$ref": "#/$defs/sha256" },
    "pdfjs_version": { "const": "5.4.624" },
    "generation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path", "source_file_name", "start_page", "end_page", "max_items", "max_characters", "max_output_characters", "deadline_ms", "occurrence_offsets", "bbox"],
      "properties": {
        "source_path": { "const": "source.pdf" },
        "source_file_name": { "const": "source.pdf" },
        "start_page": { "const": 1 },
        "end_page": { "const": "source_page_count" },
        "max_items": { "const": 5000 },
        "max_characters": { "const": 100000 },
        "max_output_characters": { "const": 200000 },
        "deadline_ms": { "const": 20000 },
        "occurrence_offsets": { "const": "unicode_code_point_half_open" },
        "bbox": { "const": "rounded_whole_oda_item_union" }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "raw_sha256", "canonical_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 },
        "raw_sha256": { "$ref": "#/$defs/sha256" }, "canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dualBindings": {
      "type": "object", "additionalProperties": false, "required": ["document", "schema"],
      "properties": { "document": { "$ref": "#/$defs/fileBinding" }, "schema": { "$ref": "#/$defs/fileBinding" } }
    },
    "sourceBinding": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": { "enum": ["accessibility_inspection_module", "generator_script", "layout_evidence_module", "layout_extraction_module", "type3_cm_reference_module", "type3_cm_pk_reference_module", "layout_oracle_schema", "markdown_conversion_module", "output_schemas_module", "package_json", "package_lock", "pdf_comparison_module", "pdf_observations_module", "pdfjs_package", "scoring_oracle_schema", "table_proposal_verification_module"] },
        "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "span": {
      "type": "object", "additionalProperties": false, "required": ["source_item_id", "start_code_point", "end_code_point"],
      "properties": {
        "source_item_id": { "type": "string", "minLength": 1 },
        "start_code_point": { "type": "integer", "minimum": 0 },
        "end_code_point": { "type": "integer", "minimum": 1 }
      }
    },
    "bbox": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "layout_ir_sha256", "page", "line_id", "line_start_code_point", "line_end_code_point", "source_item_ids", "source_spans", "quote", "bbox", "occurrence_sha256"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" }, "layout_ir_sha256": { "$ref": "#/$defs/sha256" },
        "page": { "type": "integer", "minimum": 1 },
        "line_id": { "type": "string", "minLength": 1 },
        "line_start_code_point": { "type": "integer", "minimum": 0 },
        "line_end_code_point": { "type": "integer", "minimum": 1 },
        "source_item_ids": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "source_spans": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/span" } },
        "quote": { "type": "string", "minLength": 1 }, "bbox": { "$ref": "#/$defs/bbox" },
        "occurrence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "field_path", "anchor_text", "page", "status", "status_reason", "geometry_status", "geometry_reason", "observed_occurrence_sha256", "approved_occurrence"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 }, "field_path": { "type": "string" },
        "anchor_text": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["approved_unique", "absent", "ambiguous", "layout_unavailable", "coordinate_unavailable"] },
        "status_reason": { "type": "string", "minLength": 1 },
        "geometry_status": { "enum": ["eligible", "unavailable"] },
        "geometry_reason": { "type": ["string", "null"] },
        "observed_occurrence_sha256": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/sha256" } },
        "approved_occurrence": { "anyOf": [{ "$ref": "#/$defs/occurrence" }, { "type": "null" }] }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "source_path", "source_sha256", "source_bytes", "page_count", "layout_ir_sha256", "layout_id_scope_sha256", "layout_extraction_status", "facts"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 }, "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" }, "source_bytes": { "type": "integer", "minimum": 1 },
        "page_count": { "type": "integer", "minimum": 1 }, "layout_ir_sha256": { "$ref": "#/$defs/sha256" },
        "layout_id_scope_sha256": { "$ref": "#/$defs/sha256" },
        "layout_extraction_status": { "enum": ["complete", "partial", "failed"] },
        "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } }
      }
    }
  }
}
