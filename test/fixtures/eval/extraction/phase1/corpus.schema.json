{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/corpus.schema.json",
  "title": "PDF Tools extraction Phase 1 retained corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "corpus_version", "privacy_policy", "publication_authorized", "manifest", "manifest_schema", "selected_case_ids", "fixtures", "fixture_set_sha256", "total_fixture_bytes"],
  "properties": {
    "corpus_id": { "const": "pdf-tools.extraction-phase1-retained-corpus.v1" },
    "corpus_version": { "const": 1 },
    "privacy_policy": { "enum": ["public_synthetic", "private_local"] },
    "publication_authorized": { "const": false },
    "manifest": { "$ref": "#/$defs/jsonBinding" },
    "manifest_schema": { "$ref": "#/$defs/jsonBinding" },
    "selected_case_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fixtures": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/fixture" } },
    "fixture_set_sha256": { "$ref": "#/$defs/sha256" },
    "total_fixture_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jsonBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_base64", "bytes", "raw_sha256", "canonical_sha256"],
      "properties": {
        "raw_base64": { "type": "string", "minLength": 4, "maxLength": 22369628, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "raw_sha256": { "$ref": "#/$defs/sha256" }, "canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "case_id", "manifest_relative_path", "media_type", "bytes", "sha256", "bytes_base64", "page_count", "privacy_class", "contains_personal_data"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 100 }, "case_id": { "type": "string", "minLength": 1 },
        "manifest_relative_path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.pdf$" },
        "media_type": { "const": "application/pdf" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }, "bytes_base64": { "type": "string", "minLength": 4, "maxLength": 22369628, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }, "page_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "privacy_class": { "enum": ["synthetic", "public", "private"] }, "contains_personal_data": { "type": "boolean" }
      }
    }
  }
}
