{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/artifact-config.schema.json",
  "title": "PDF Tools extraction Phase 1 runner-owned artifact configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_id", "candidate_id", "configured", "root_specs", "role_dispositions", "components", "licenses"],
  "properties": {
    "config_id": { "const": "pdf-tools.extraction-phase1-artifact-config.v1" },
    "candidate_id": { "$ref": "#/$defs/candidateId" },
    "configured": { "type": "boolean" },
    "root_specs": { "type": "array", "items": { "$ref": "#/$defs/rootSpec" } },
    "role_dispositions": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/roleDisposition" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "licenses": { "type": "array", "items": { "$ref": "#/$defs/license" } }
  },
  "allOf": [
    {
      "if": { "properties": { "configured": { "const": false } }, "required": ["configured"] },
      "then": {
        "properties": {
          "root_specs": { "maxItems": 0 },
          "components": { "maxItems": 0 },
          "licenses": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "configured": { "const": true } }, "required": ["configured"] },
      "then": {
        "properties": {
          "root_specs": { "minItems": 1 },
          "role_dispositions": { "minItems": 16, "maxItems": 16 },
          "components": { "minItems": 1 },
          "licenses": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "role": { "enum": ["adapter_entrypoint", "adapter_source", "candidate_config", "environment_lock", "installed_distribution", "interpreter", "license_review", "license_text", "model_config", "model_weights", "native_bridge", "ocr_bridge", "required_data", "runtime_config", "system_component", "tokenizer_preprocessor"] },
    "rootRole": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "candidateId": { "enum": ["control.current_product.v0", "candidate.layout_ir.v1", "candidate.direct_pdf.v1", "candidate.raster.v1", "candidate.remote_model.v1"] },
    "roleDisposition": {
      "type": "object", "additionalProperties": false, "required": ["role", "status", "reason"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "status": { "enum": ["required", "not_applicable", "pending"] },
        "reason": { "type": ["string", "null"], "enum": [null, "candidate_not_configured", "not_used_by_candidate", "runner_runtime_closure_incomplete", "synthetic_test_double_nonclaiming"] }
      }
    },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "rootSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_role", "artifact_role", "component_id", "license_ids", "path", "required", "allow_symlinks", "allow_hardlink_groups"],
      "properties": {
        "root_role": { "$ref": "#/$defs/rootRole" },
        "artifact_role": { "$ref": "#/$defs/role" },
        "component_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "license_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" } },
        "path": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "allow_symlinks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/relativePath" } },
        "allow_hardlink_groups": { "type": "array", "items": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version", "source_reference", "source_revision", "license_ids", "artifact_roles"],
      "properties": {
        "component_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "version": { "type": "string", "minLength": 1 },
        "source_reference": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "license_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" } },
        "artifact_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "license_id", "license_name", "license_text_artifact_id", "review_record_artifact_id", "review_record_sha256", "review_scope", "reviewed_at", "status"],
      "properties": {
        "license_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "component_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "license_name": { "type": "string", "minLength": 1 },
        "license_text_artifact_id": { "type": "string", "minLength": 1 },
        "review_record_artifact_id": { "type": "string", "minLength": 1 },
        "review_record_sha256": { "$ref": "#/$defs/sha256" },
        "review_scope": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["reviewed_license", "pending_review"] }
      }
    }
  }
}
