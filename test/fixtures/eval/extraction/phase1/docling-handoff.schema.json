{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/docling-handoff.schema.json",
  "title": "PDF Tools Docling macOS handoff receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "handoff_id", "execution_state", "identity", "platform", "toolchain", "roots", "inputs", "fixtures", "setup", "execution", "claim_boundary"],
  "properties": {
    "protocol": { "const": "pdf-tools.docling-macos-handoff.v1" },
    "handoff_id": { "$ref": "#/$defs/sha256" },
    "execution_state": { "const": "not_run" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "platform_contract", "inputs", "fixtures", "recipe"],
      "properties": {
        "protocol": { "const": "pdf-tools.docling-macos-handoff.v1" },
        "platform_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "architecture", "interpreter"],
          "properties": {
            "platform": { "const": "darwin" },
            "architecture": { "const": "arm64" },
            "interpreter": { "const": "cpython-3.12.13-macos-aarch64-none" }
          }
        },
        "inputs": { "$ref": "#/$defs/input_inventory" },
        "fixtures": { "$ref": "#/$defs/fixture_inventory" },
        "recipe": {
          "type": "object", "additionalProperties": false,
          "required": ["setup", "execution"],
          "properties": {
            "setup": {
              "type": "object", "additionalProperties": false,
              "required": ["network_required", "environment", "authority_command", "commands", "finalization"],
              "properties": {
                "network_required": { "const": true },
                "environment": { "$ref": "#/$defs/normalized_setup_environment" },
                "authority_command": { "$ref": "#/$defs/command" },
                "commands": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/command" } },
                "finalization": { "type": "object", "additionalProperties": false, "required": ["protocol", "out_of_band_sha256_required"], "properties": { "protocol": { "const": "pdf-tools.docling-finalization.v1" }, "out_of_band_sha256_required": { "const": true } } }
              }
            },
            "execution": {
              "type": "object", "additionalProperties": false,
              "required": ["offline_intent", "network_isolation_enforced", "environment", "candidate_execution", "adapter_command", "supervisor"],
              "properties": {
                "offline_intent": { "const": true },
                "network_isolation_enforced": { "const": false },
                "environment": { "$ref": "#/$defs/normalized_execution_environment" },
                "candidate_execution": { "const": "retained_bakeoff_capture_only" },
                "adapter_command": { "$ref": "#/$defs/command" },
                "supervisor": { "$ref": "#/$defs/normalized_supervisor" }
              }
            }
          }
        }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["interpreter", "operating_system", "architecture", "os_build", "kernel_release", "node_version"],
      "properties": {
        "interpreter": { "const": "cpython-3.12.13-macos-aarch64-none" },
        "operating_system": { "const": "macos" },
        "architecture": { "const": "arm64" },
        "os_build": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "const": "capture_at_setup" } },
        "kernel_release": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" }
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["uv", "node"],
      "properties": {
        "uv": { "$ref": "#/$defs/uv_identity" },
        "node": { "$ref": "#/$defs/node_identity" }
      }
    },
    "roots": {
      "type": "object", "additionalProperties": false,
      "required": ["uv", "uv_python_install", "models", "runs", "sidecar_snapshot", "authority_home", "authority_tmp", "hf_cache", "protected_roots_sha256"],
      "properties": {
        "uv": { "$ref": "#/$defs/absolute_path" },
        "uv_python_install": { "$ref": "#/$defs/absolute_path" },
        "models": { "$ref": "#/$defs/absolute_path" },
        "runs": { "$ref": "#/$defs/absolute_path" },
        "sidecar_snapshot": { "$ref": "#/$defs/absolute_path" },
        "authority_home": { "$ref": "#/$defs/absolute_path" },
        "authority_tmp": { "$ref": "#/$defs/absolute_path" },
        "hf_cache": { "$ref": "#/$defs/absolute_path" },
        "protected_roots_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputs": { "$ref": "#/$defs/input_inventory" },
    "fixtures": { "$ref": "#/$defs/fixture_inventory" },
    "setup": {
      "type": "object", "additionalProperties": false,
      "required": ["network_required", "environment", "authority_command", "commands", "finalization"],
      "properties": {
        "network_required": { "const": true },
        "environment": { "$ref": "#/$defs/setup_environment" },
        "authority_command": { "$ref": "#/$defs/command" },
        "commands": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/command" } },
        "finalization": { "type": "object", "additionalProperties": false, "required": ["protocol", "path", "out_of_band_sha256_required"], "properties": { "protocol": { "const": "pdf-tools.docling-finalization.v1" }, "path": { "$ref": "#/$defs/absolute_path" }, "out_of_band_sha256_required": { "const": true } } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["offline_intent", "network_isolation_enforced", "environment", "candidate_execution", "adapter_command", "supervisor", "fixture_presentation"],
      "properties": {
        "offline_intent": { "const": true },
        "network_isolation_enforced": { "const": false },
        "environment": { "$ref": "#/$defs/execution_environment" },
        "candidate_execution": { "const": "retained_bakeoff_capture_only" },
        "adapter_command": { "$ref": "#/$defs/command" },
        "supervisor": { "$ref": "#/$defs/supervisor" },
        "fixture_presentation": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "claim_boundary": { "const": "Unexecuted private evaluation handoff only. No benchmark, package, product, redistribution, or release claim is authorized." }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolute_path": { "type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096 },
    "command": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
    "uv_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "bytes", "sha256", "mode", "links"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^uv [0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?(?: \\([a-f0-9]{7,40} (?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29) [a-z0-9_]+(?:-[a-z0-9_]+){2,4}\\))?$(?![\\s\\S])" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "links": { "const": 1 }
      }
    },
    "node_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "bytes", "sha256", "mode", "links"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "links": { "const": 1 }
      }
    },
    "input_record": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "filename", "bytes", "sha256"],
      "properties": {
        "role": { "enum": ["adapter_entrypoint", "model_setup_helper", "candidate_config", "candidate_config_schema", "candidate_request_schema", "candidate_response_schema", "handoff_schema", "handoff_generator_source", "handoff_verifier_source", "runtime_evidence_source", "handoff_authority", "handoff_verifier_cli", "finalization_schema", "supervisor_source", "supervisor_controller", "supervisor_evidence_schema", "supervisor_calibration_attestation", "bakeoff_capture_source", "direct_requirements"] },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 255 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "input_inventory": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/input_record" } },
    "fixture_record": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "filename", "bytes", "sha256"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 100 },
        "filename": { "type": "string", "pattern": "^source-[0-9]{3}-[a-f0-9]{12}\\.pdf$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture_inventory": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/fixture_record" } },
    "setup_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["HOME", "TMPDIR", "PATH", "LANG", "LC_ALL", "HF_HOME", "UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR", "PYTHONDONTWRITEBYTECODE"],
      "properties": { "HOME": { "$ref": "#/$defs/absolute_path" }, "TMPDIR": { "$ref": "#/$defs/absolute_path" }, "PATH": { "const": "/usr/bin:/bin" }, "LANG": { "const": "C" }, "LC_ALL": { "const": "C" }, "HF_HOME": { "$ref": "#/$defs/absolute_path" }, "UV_CACHE_DIR": { "$ref": "#/$defs/absolute_path" }, "UV_PYTHON_INSTALL_DIR": { "$ref": "#/$defs/absolute_path" }, "PYTHONDONTWRITEBYTECODE": { "const": "1" } }
    },
    "execution_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["HOME", "TMPDIR", "PATH", "LANG", "LC_ALL", "HF_HOME", "HF_HUB_OFFLINE", "TRANSFORMERS_OFFLINE", "HF_DATASETS_OFFLINE", "UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR", "PYTHONDONTWRITEBYTECODE"],
      "properties": {
        "HF_HUB_OFFLINE": { "const": "1" }, "TRANSFORMERS_OFFLINE": { "const": "1" }, "HF_DATASETS_OFFLINE": { "const": "1" },
        "HOME": { "$ref": "#/$defs/absolute_path" }, "TMPDIR": { "$ref": "#/$defs/absolute_path" }, "PATH": { "const": "/usr/bin:/bin" }, "LANG": { "const": "C" }, "LC_ALL": { "const": "C" },
        "HF_HOME": { "$ref": "#/$defs/absolute_path" },
        "UV_CACHE_DIR": { "$ref": "#/$defs/absolute_path" }, "UV_PYTHON_INSTALL_DIR": { "$ref": "#/$defs/absolute_path" }, "PYTHONDONTWRITEBYTECODE": { "const": "1" }
      }
    },
    "normalized_setup_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["HOME", "TMPDIR", "PATH", "LANG", "LC_ALL", "HF_HOME", "UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR", "PYTHONDONTWRITEBYTECODE"],
      "properties": { "HOME": { "const": "$AUTHORITY_HOME" }, "TMPDIR": { "const": "$AUTHORITY_TMP" }, "PATH": { "const": "/usr/bin:/bin" }, "LANG": { "const": "C" }, "LC_ALL": { "const": "C" }, "HF_HOME": { "const": "$HF_CACHE_ROOT" }, "UV_CACHE_DIR": { "const": "$UV_CACHE_ROOT" }, "UV_PYTHON_INSTALL_DIR": { "const": "$UV_PYTHON_INSTALL_ROOT" }, "PYTHONDONTWRITEBYTECODE": { "const": "1" } }
    },
    "normalized_execution_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["HOME", "TMPDIR", "PATH", "LANG", "LC_ALL", "HF_HOME", "HF_HUB_OFFLINE", "TRANSFORMERS_OFFLINE", "HF_DATASETS_OFFLINE", "UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR", "PYTHONDONTWRITEBYTECODE"],
      "properties": {
        "HF_HUB_OFFLINE": { "const": "1" }, "TRANSFORMERS_OFFLINE": { "const": "1" }, "HF_DATASETS_OFFLINE": { "const": "1" },
        "HOME": { "const": "$AUTHORITY_HOME" }, "TMPDIR": { "const": "$AUTHORITY_TMP" }, "PATH": { "const": "/usr/bin:/bin" }, "LANG": { "const": "C" }, "LC_ALL": { "const": "C" },
        "HF_HOME": { "const": "$HF_CACHE_ROOT" },
        "UV_CACHE_DIR": { "const": "$UV_CACHE_ROOT" }, "UV_PYTHON_INSTALL_DIR": { "const": "$UV_PYTHON_INSTALL_ROOT" }, "PYTHONDONTWRITEBYTECODE": { "const": "1" }
      }
    },
    "supervisor_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "calibration_attestation_sha256", "sample_interval_ms", "leader_exit_grace_ms", "sampled_group_physical_footprint_max_bytes", "address_space_bytes", "cpu_seconds", "file_size_bytes", "nofile"],
      "properties": {
        "protocol": { "const": "pdf-tools.docling-macos-supervisor-policy.v1" },
        "calibration_attestation_sha256": { "const": "8a532eea6c54ebbdc7d1509296efb763a6cda6ca0756b34970cbe8bad934f778" },
        "sample_interval_ms": { "const": 50 },
        "leader_exit_grace_ms": { "const": 2000 },
        "sampled_group_physical_footprint_max_bytes": { "const": 4294967296 },
        "address_space_bytes": { "const": 1099511627776 },
        "cpu_seconds": { "const": 120 },
        "file_size_bytes": { "const": 536870912 },
        "nofile": { "const": 1024 }
      }
    },
    "supervisor_file_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "links"],
      "properties": {
        "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "enum": [384, 448, 493] },
        "links": { "const": 1 }
      }
    },
    "supervisor_build": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "platform", "source", "compiler", "sdk", "command", "testing", "binary"],
      "properties": {
        "protocol": { "const": "pdf-tools.macos-eval-supervisor-build.v1" },
        "platform": {
          "type": "object", "additionalProperties": false,
          "required": ["operating_system", "architecture", "os_build", "kernel_release"],
          "properties": {
            "operating_system": { "const": "macos" },
            "architecture": { "const": "arm64" },
            "os_build": { "type": "string", "minLength": 1, "maxLength": 128 },
            "kernel_release": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "source": { "$ref": "#/$defs/supervisor_file_identity" },
        "compiler": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "bytes", "sha256", "mode", "links", "version"],
          "properties": {
            "path": { "$ref": "#/$defs/absolute_path" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "mode": { "const": 493 },
            "links": { "const": 1 },
            "version": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "sdk": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "version"],
          "properties": {
            "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "command": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
        "testing": { "const": false },
        "binary": { "$ref": "#/$defs/supervisor_file_identity" }
      }
    },
    "normalized_supervisor": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "build"],
      "properties": {
        "policy": { "$ref": "#/$defs/supervisor_policy" },
        "build": { "$ref": "#/$defs/supervisor_build" }
      }
    },
    "supervisor": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "build"],
      "properties": {
        "policy": { "$ref": "#/$defs/supervisor_policy" },
        "build": { "$ref": "#/$defs/supervisor_build" }
      }
    }
  }
}
