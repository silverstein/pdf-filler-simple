{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/docling-finalization.schema.json",
  "title": "PDF Tools Docling setup finalization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "handoff_id", "receipt_sha256", "platform", "toolchain", "lock", "python", "installed_distributions", "model_files", "managed_python_files", "venv_files", "root_policy", "network_isolation_enforced", "execution_state", "finalization_id"],
  "properties": {
    "protocol": { "const": "pdf-tools.docling-finalization.v1" },
    "handoff_id": { "$ref": "#/$defs/sha256" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" },
    "platform": { "$ref": "#/$defs/platform" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "lock": { "$ref": "#/$defs/file_identity" },
    "python": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "version"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" }, "version": { "type": "string", "pattern": "^Python 3\\.12\\.13$" }
      }
    },
    "installed_distributions": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "string", "minLength": 1 }] }
    },
    "model_files": { "$ref": "#/$defs/private_tree_inventory" },
    "managed_python_files": { "$ref": "#/$defs/runtime_tree_inventory" },
    "venv_files": { "$ref": "#/$defs/runtime_tree_inventory" },
    "root_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["uv", "uv_python_install", "models", "runs", "sidecar_snapshot", "authority_home", "authority_tmp", "hf_cache"],
      "properties": {
        "uv": { "$ref": "#/$defs/root_record" }, "uv_python_install": { "$ref": "#/$defs/root_record" },
        "models": { "$ref": "#/$defs/root_record" }, "runs": { "$ref": "#/$defs/root_record" },
        "sidecar_snapshot": { "$ref": "#/$defs/root_record" }, "authority_home": { "$ref": "#/$defs/root_record" },
        "authority_tmp": { "$ref": "#/$defs/root_record" }, "hf_cache": { "$ref": "#/$defs/root_record" }
      }
    },
    "network_isolation_enforced": { "const": false },
    "execution_state": { "const": "setup_complete_not_executed" },
    "finalization_id": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolute_path": { "type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096 },
    "canonical_relative_path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!\\.\\.?($|/))(?!.*\\/\\.\\.?($|/))[^/\\\\]+(?:/[^/\\\\]+)*$" },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["interpreter", "operating_system", "architecture", "os_build", "kernel_release", "node_version"],
      "properties": {
        "interpreter": { "const": "cpython-3.12.13-macos-aarch64-none" }, "operating_system": { "const": "macos" },
        "architecture": { "const": "arm64" }, "os_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kernel_release": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" }
      }
    },
    "uv_identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "version", "bytes", "sha256", "mode", "links"],
      "properties": { "path": { "$ref": "#/$defs/absolute_path" }, "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^uv [0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?(?: \\([a-f0-9]{7,40} (?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29) [a-z0-9_]+(?:-[a-z0-9_]+){2,4}\\))?$(?![\\s\\S])" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "sha256": { "$ref": "#/$defs/sha256" }, "mode": { "type": "integer", "minimum": 0, "maximum": 511 }, "links": { "const": 1 } }
    },
    "node_identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "version", "bytes", "sha256", "mode", "links"],
      "properties": { "path": { "$ref": "#/$defs/absolute_path" }, "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "sha256": { "$ref": "#/$defs/sha256" }, "mode": { "type": "integer", "minimum": 0, "maximum": 511 }, "links": { "const": 1 } }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["uv", "node"],
      "properties": { "uv": { "$ref": "#/$defs/uv_identity" }, "node": { "$ref": "#/$defs/node_identity" } }
    },
    "file_identity": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "sha256"],
      "properties": { "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "root_record": {
      "type": "object", "additionalProperties": false, "required": ["path", "real_path", "mode", "links"],
      "properties": { "path": { "$ref": "#/$defs/absolute_path" }, "real_path": { "$ref": "#/$defs/absolute_path" }, "mode": { "const": 448 }, "links": { "type": "integer", "minimum": 1 } }
    },
    "private_tree_entry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links", "bytes", "sha256"],
          "properties": {
            "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "file" },
            "mode": { "enum": [384, 420, 448, 493] }, "links": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }, "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links"],
          "properties": { "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "directory" }, "mode": { "enum": [448, 493] }, "links": { "type": "integer", "minimum": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links", "target"],
          "properties": { "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "symlink" }, "mode": { "const": 511 }, "links": { "const": 1 }, "target": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        }
      ]
    },
    "runtime_tree_entry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links", "bytes", "sha256"],
          "properties": {
            "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "file" },
            "mode": { "enum": [384, 420, 448, 457, 493] }, "links": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }, "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links"],
          "properties": { "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "directory" }, "mode": { "enum": [448, 493] }, "links": { "type": "integer", "minimum": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["relative_path", "type", "mode", "links", "target"],
          "properties": { "relative_path": { "$ref": "#/$defs/canonical_relative_path" }, "type": { "const": "symlink" }, "mode": { "const": 511 }, "links": { "const": 1 }, "target": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        }
      ]
    },
    "private_tree_inventory": { "type": "array", "minItems": 1, "maxItems": 50000, "items": { "$ref": "#/$defs/private_tree_entry" } },
    "runtime_tree_inventory": { "type": "array", "minItems": 1, "maxItems": 50000, "items": { "$ref": "#/$defs/runtime_tree_entry" } }
  }
}
