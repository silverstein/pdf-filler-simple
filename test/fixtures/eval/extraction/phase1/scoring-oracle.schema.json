{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/phase1/scoring-oracle.schema.json",
  "title": "PDF Tools extraction Phase 1 scorer-only oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle_id", "oracle_version", "phase0_manifest_sha256", "manifest_bytes_sha256", "manifest_schema_sha256", "manifest_schema_bytes_sha256", "cases"],
  "properties": {
    "oracle_id": { "const": "pdf-tools.extraction-phase1-scoring-oracle.v1" },
    "oracle_version": { "const": 1 },
    "phase0_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_bytes_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_schema_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_schema_bytes_sha256": { "$ref": "#/$defs/sha256" },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "target_schema_sha256", "expected_pages_sha256", "expected_table_sha256", "contract_leaf_policies", "truth_leaves", "fact_ids"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^pdf-tools\\.extraction\\.phase0\\.[a-z0-9.-]+$" },
          "target_schema_sha256": { "$ref": "#/$defs/sha256" },
          "expected_pages_sha256": { "$ref": "#/$defs/sha256" },
          "expected_table_sha256": { "$ref": "#/$defs/sha256" },
          "contract_leaf_policies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_path", "expected_decision", "allowed_gap_reasons"],
              "properties": {
                "field_path": { "type": "string", "pattern": "^(?:|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$" },
                "expected_decision": { "enum": ["answer", "abstain"] },
                "allowed_gap_reasons": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["insufficient_evidence", "contradictory_source", "absent_in_source", "unsupported_modality", "resource_limit", "candidate_failure"] }
                }
              }
            }
          },
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^fact\\.[a-z0-9.-]+$" }
          },
          "truth_leaves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["field_path", "contract_path", "value", "disposition", "fact_support"],
              "properties": {
                "field_path": { "type": "string", "pattern": "^/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*$" },
                "contract_path": { "type": "string", "pattern": "^/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*$" },
                "value": {},
                "disposition": { "enum": ["answer", "abstain"] },
                "fact_support": {
                  "type": "object", "additionalProperties": false,
                  "required": ["mode", "fact_ids"],
                  "properties": {
                    "mode": { "enum": ["none", "any", "all"] },
                    "fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^fact\\.[a-z0-9.-]+$" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
