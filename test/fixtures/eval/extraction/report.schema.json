{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Document-Alliance/PDF-Tools/test/fixtures/eval/extraction/report.schema.json",
  "title": "PDF Tools structured extraction Phase 0 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version", "suite_id", "suite_version", "benchmark_claim_ready", "calibration_claim_ready",
    "claim_boundary", "manifest_sha256", "schema_sha256", "run", "denominator",
    "aggregate_metrics", "cases", "limitations"
  ],
  "properties": {
    "report_schema_version": { "const": 1 },
    "suite_id": { "const": "pdf-tools.extraction.phase0" },
    "suite_version": { "type": "string" },
    "benchmark_claim_ready": { "const": false },
    "calibration_claim_ready": { "const": false },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_version", "runtime_commit", "node_version", "platform", "architecture", "tool_contract_sha256", "tools_observed"],
      "properties": {
        "runtime_version": { "type": "string" },
        "runtime_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "node_version": { "type": "string" },
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "tool_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tools_observed": { "type": "integer", "minimum": 1 }
      }
    },
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["planned", "attempted", "completed", "product_failures", "product_timeouts", "invalid_outputs", "harness_failures", "planned_case_ids", "observed_case_ids"],
      "properties": {
        "planned": { "const": 8 },
        "attempted": { "type": "integer", "minimum": 0, "maximum": 8 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 8 },
        "product_failures": { "type": "integer", "minimum": 0, "maximum": 8 },
        "product_timeouts": { "type": "integer", "minimum": 0, "maximum": 8 },
        "invalid_outputs": { "type": "integer", "minimum": 0, "maximum": 8 },
        "harness_failures": { "type": "integer", "minimum": 0, "maximum": 8 },
        "planned_case_ids": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string" } },
        "observed_case_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aggregate_metrics": { "type": "object" },
    "cases": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "object" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
