    },
    {
      "id": "G03",
      "gate": "established_identity_provider_and_oauth_interop",
      "evidence": "PKCE, protected resource metadata, signature, issuer, audience and resource, expiry, not-before, scope, JWKS issuer-key binding, key rotation and stale-key behavior, replay considerations, revocation or short-life, and negative token tests across target hosts."
    },
    {
      "id": "G04",
      "gate": "tenant_isolation",
      "evidence": "Independent adversarial tests across list, search, count, fetch, mutation, job, notification, export, deletion, and deep-link surfaces."
    },
    {
      "id": "G05",
      "gate": "explicit_upload_and_download_authorization",
      "evidence": "Human-observed UI and protocol receipts bind verified actor, one exact object or content identity, tenant, workspace, direction, destination or audience, purpose, scope, expiry, and a single-use nonce atomically consumed; replay, concurrent double redemption, wrong actor, wrong object, and wrong audience fail."
    },
    {
      "id": "G06",
      "gate": "bounded_document_worker",
      "evidence": "Hostile corpus proves parser, CPU, memory, time, output, concurrency, egress, and crash isolation limits."
    },
    {
      "id": "G07",
      "gate": "mutation_and_provenance_integrity",
      "evidence": "Exact source, actor, operation, tool version, canonical arguments digest, authorization or approval record, policy, destination and effects preconditions; same-key different-argument rejection; dequeue, pre-activation, and release authorization rechecks; atomic activation, immutable versions, visual and structural validation, and identity-bound receipt."
    },
    {
      "id": "G08",
      "gate": "lifecycle_and_deletion",
