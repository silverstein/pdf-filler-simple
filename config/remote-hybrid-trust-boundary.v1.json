  "modes": [
    {
      "id": "local_only",
      "custody": "user_device",
      "network_egress_of_document_bytes": false,
      "allowed_inputs": [
        "explicitly_permitted_local_pdf"
      ],
      "steps": [
        "Human permits a local path through the desktop host.",
        "Local MCPB reads or mutates within its existing path and approval controls.",
        "Output remains local and receives byte length and SHA-256 identity."
      ],
      "remote_service_dependency": false
    },
    {
      "id": "remote_only",
      "custody": "remote_service",
      "network_egress_of_document_bytes": true,
      "allowed_inputs": [
        "synthetic_fixture_until_production_gates_pass"
      ],
      "required_consent_event": "explicit_document_upload_authorization",
      "steps": [
        "Human creates or selects a tenant-scoped remote workspace.",
        "Human explicitly authorizes upload of a named document identity.",
        "Service stores an immutable source object and returns a remote document identity.",
        "Every mutation creates a new version after object-level authorization and identity precondition checks.",
        "Human reviews provenance and output identity before export.",
        "Retention or deletion follows an explicit workspace policy and verifiable lifecycle."
      ],
      "local_filesystem_dependency": false
    },
    {
      "id": "hybrid_explicit_handoff",
      "custody": "changes_only_at_explicit_handoff",
      "network_egress_of_document_bytes": true,
      "allowed_inputs": [
        "synthetic_fixture_until_production_gates_pass"
      ],
      "required_consent_event": "explicit_content_addressed_handoff_authorization",
      "steps": [
        "Local companion identifies permitted bytes without granting remote filesystem access.",
        "Human authorizes one content-addressed document and destination workspace.",
        "A one-time, least-privilege transfer grant moves only those bytes.",
        "Remote operations create versioned outputs with provenance.",
        "Human authorizes an explicit content-addressed return transfer.",
        "Local companion writes to a new or identity-approved destination."
      ],
      "forbidden_shortcuts": [
        "remote_connector_calls_local_mcp_directly",
        "folder_permission_implies_upload_permission",
        "ambient_shared_directory_sync",
        "path_string_as_cross_boundary_identity"
      ]
    },
    {
      "id": "cowork_host_folder_bridge",
      "custody": "local_folder_bridged_through_claude_desktop_and_processed_remotely",
      "network_egress_of_document_bytes": true,
      "status": "host_capability_not_pdf_tools_remote_architecture",
      "required_consent_event": "host_connected_folder_permission",
      "steps": [
        "Human connects a bounded folder in Claude Desktop.",
        "A remote Cowork session requests a permitted file through the desktop bridge while the app is online.",
        "Anthropic processes the file in the remote session under its product data boundary."
      ],
      "must_not_be_described_as": [
        "local_mcp_in_remote_session",
        "pdf_tools_remote_service",
        "document_stays_on_device"
      ]
    },
    {
      "id": "cowork_host_desktop_brokered_local_connector",
      "custody": "local_connector_execution_brokered_through_claude_desktop_with_results_processed_in_remote_session",
      "network_egress_of_document_bytes": true,
      "status": "documented_host_path_exact_pdf_tools_mcpb_unverified",
      "required_consent_event": "host_local_connector_permission_plus_exact_tool_approval",
      "steps": [
        "Human enables a local connector or plugin containing local MCP in Claude Desktop.",
        "A remote Cowork session requests the permitted local connector through the online desktop app.",
        "The local MCP executes on the desktop side, not inside the remote sandbox.",
        "Tool inputs and results used by the remote session cross into Anthropic's processing boundary."
      ],
      "must_not_be_described_as": [
        "local_mcp_inside_remote_sandbox",
        "exact_pdf_tools_mcpb_compatibility_without_native_host_evidence",
        "document_or_tool_results_stay_entirely_on_device"
      ]
    }
  ],
