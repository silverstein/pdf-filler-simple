  "decisions": {
    "local_product": {
      "verdict": "GO_CONTINUE",
      "scope": "Current local stdio MCPB for files explicitly permitted on the user's device.",
      "reason": "It preserves the existing local custody and distribution boundary. Remote architecture is a sibling product surface, not a packaging change."
    },
    "remote_production_service": {
      "verdict": "WAIT",
      "scope": "Any publicly reachable service that receives or produces user document bytes.",
      "reason": "Current architecture research establishes feasibility, but production auth, tenant isolation, custody, deletion, abuse, host, and exact-workflow gates remain unproven."
    },
    "bounded_vertical_slice": {
      "verdict": "GO_LOCAL_MOCK_ONLY",
      "scope": "Synthetic metadata and synthetic PDF fixtures in a loopback-only mock. No provider deployment, public listener, account mutation, or user-data egress.",
      "reason": "This can validate contracts and fail-closed state transitions without creating a cloud custody claim."
    }
  },
  "principals": [
    {
      "id": "resource_owner",
      "kind": "human",
      "may_authorize": [
        "workspace_creation",
        "document_upload",
        "document_mutation",
        "document_export",
        "document_deletion"
      ]
    },
    {
      "id": "host_mcp_client",
