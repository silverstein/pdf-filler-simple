  "threat_register": [
    {
      "id": "T01",
      "threat": "Cross-tenant object access through guessed or caller-supplied identifiers",
      "severity": "P0",
      "required_gate": "cross_tenant_all_surface_negative_tests"
    },
    {
      "id": "T02",
      "threat": "Confused-deputy token accepted for the wrong resource or issuer",
      "severity": "P0",
      "required_gate": "issuer_audience_resource_and_scope_verification"
    },
    {
      "id": "T03",
      "threat": "Folder access or a model request is mistaken for upload consent",
      "severity": "P0",
      "required_gate": "explicit_content_addressed_upload_event"
    },
    {
      "id": "T04",
      "threat": "Prompt injection in a PDF causes external disclosure or an unreviewed mutation",
      "severity": "P0",
      "required_gate": "document_content_never_grants_authority_and_egress_is_denied"
    },
    {
      "id": "T05",
      "threat": "Stale review mutates a document version different from the one approved",
      "severity": "P0",
      "required_gate": "source_identity_precondition_and_atomic_version_creation"
    },
    {
      "id": "T06",
      "threat": "A retry duplicates an expensive or consequential mutation",
      "severity": "P1",
      "required_gate": "tenant_scoped_idempotency_and_replay_tests"
    },
    {
      "id": "T07",
      "threat": "Task handles leak status, inputs, or results across tenants",
      "severity": "P0",
      "required_gate": "task_object_authorization_on_get_update_cancel"
    },
    {
      "id": "T08",
      "threat": "Cancellation is represented as deletion while bytes or work remain",
      "severity": "P1",
      "required_gate": "separate_task_cancel_document_delete_and_purge_states"
    },
    {
      "id": "T09",
      "threat": "Signed download URLs grant broad, long-lived, or replayable access",
      "severity": "P0",
      "required_gate": "actor_tenant_workspace_object_version_direction_audience_expiry_bound_single_use_atomic_download_grant_with_replay_tests"
    },
    {
      "id": "T10",
      "threat": "Document content, tokens, or filenames enter logs and traces",
      "severity": "P1",
      "required_gate": "redaction_tests_and_content_free_audit_schema"
    },
    {
      "id": "T11",
      "threat": "Malformed, huge, recursive, or adversarial PDFs exhaust a shared worker",
      "severity": "P1",
      "required_gate": "isolated_bounded_workers_and_hostile_corpus"
    },
    {
      "id": "T12",
      "threat": "A local companion exposes an ambient network or filesystem capability",
      "severity": "P0",
      "required_gate": "loopback_authenticated_one_time_object_grants_only"
    },
    {
      "id": "T13",
      "threat": "UI approval text is not cryptographically bound to the invoked operation",
      "severity": "P0",
      "required_gate": "approval_binds_tenant_document_identity_operation_and_arguments"
    },
    {
      "id": "T14",
      "threat": "Deletion omits derived versions, jobs, caches, backups, or indexes",
      "severity": "P1",
      "required_gate": "lifecycle_inventory_and_bounded_purge_receipt"
    },
    {
      "id": "T15",
      "threat": "Host-specific UI, Tasks, or file APIs are claimed as portable MCP",
      "severity": "P1",
      "required_gate": "capability_detection_and_host_specific_evidence_rows"
    },
    {
      "id": "T16",
      "threat": "HTTP routing or policy uses headers that disagree with the JSON-RPC body",
      "severity": "P0",
      "required_gate": "required_header_body_mismatch_rejection"
    }
  ],
