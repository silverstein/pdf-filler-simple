  ],
  "architecture_idempotency_contract": {
    "scope": "tenant_id_plus_verified_actor_id_plus_idempotency_key",
    "request_identity": "source_identity_plus_tool_name_plus_tool_version_plus_canonical_arguments_sha256_plus_destination_and_effects",
    "same_key_same_request": "return_exact_prior_operation_or_terminal_receipt_without_new_effect",
    "same_key_different_request": "tool_error_IDEMPOTENCY_CONFLICT_with_no_effect",
    "concurrent_same_key": "exactly_one_operation_record_and_effect"
  },
  "architecture_error_semantics": {
    "present_invalid_null_or_multiple_origin": "http_403_before_json_rpc_dispatch",
    "missing_origin": "continue_to_authentication_and_request_validation",
    "missing_required_header_or_header_body_mismatch": "http_400_HeaderMismatch",
    "unsupported_protocol_version": "http_400_UnsupportedProtocolVersion",
    "missing_or_invalid_synthetic_auth_context": "http_401_before_tool_dispatch",
    "insufficient_scope": "http_403_before_tool_effect",
    "unknown_method": "http_404_json_rpc_method_not_found",
    "application_authorization_or_identity_failure": "http_200_tool_result_isError_true_stable_code_no_effect",
    "idempotency_conflict": "http_200_tool_result_isError_true_IDEMPOTENCY_CONFLICT_no_effect"
  },
  "mutation_linearization_order": [
