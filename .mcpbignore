# Ignore other packages
*.dxt
*.mcpb
*.zip

# Ignore sharing/distribution folders
pdf-filler-mcp-share/
pdf-filler-mcp/

# Ignore test files
test-*.pdf
*-test.pdf

# Ignore temporary files
*.tmp
*.log
.DS_Store

# Ignore git files (already handled by default)
.git/
.gitignore

# Ignore old/backup files
*.backup
*.old
manifest.dxt.backup.json

# Trim pdfjs-dist (only legacy/build/ is used at runtime)
node_modules/pdfjs-dist/build/
node_modules/pdfjs-dist/web/
node_modules/pdfjs-dist/types/
node_modules/pdfjs-dist/image_decoders/
node_modules/pdfjs-dist/cmaps/
node_modules/pdfjs-dist/wasm/

# Docs and dev files
docs/
CLAUDE.md
.claude/
example-fw9.pdf